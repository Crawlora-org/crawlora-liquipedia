{
  "name": "@crawlora-org/liquipedia",
  "version": "0.2.0",
  "description": "Crawlora Liquipedia API client with 12 endpoints for wiki discovery, pages, search, categories, recent changes, links, and backlinks",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=liquipedia-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-liquipedia/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "liquipedia", "liquipedia-api", "liquipedia-scraper", "liquipedia-data", "liquipedia-wiki-discovery", "liquipedia-pages", "liquipedia-search", "liquipedia-categories", "liquipedia-recent-changes", "liquipedia-links", "liquipedia-backlinks"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-liquipedia",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
